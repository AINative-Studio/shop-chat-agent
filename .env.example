# AINative Gateway (recommended — multi-provider, metered, ZeroMemory)
AINATIVE_API_KEY=YOUR_AINATIVE_API_KEY

# Or use Claude directly (fallback if no AINATIVE_API_KEY)
CLAUDE_API_KEY=YOUR_CLAUDE_API_KEY

# Optional: override the default model
# AINATIVE_MODEL=claude-sonnet-4-20250514

# Shopify
REDIRECT_URL=https://localhost:3458/auth/callback
SHOPIFY_API_KEY=YOUR_APP_CLIENT_ID
